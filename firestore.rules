rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: entries
    // Document ID: auto-generated
    // Fields:
    //   - mes: string
    //   - chave_acesso: string
    //   - nf_numero: string (required)
    //   - tonelada: number
    //   - valor: number
    //   - descricao_produto: string
    //   - data_nf: string
    //   - data_descarga: string
    //   - status: string (required)
    //   - fornecedor: string (required)
    //   - placa_veiculo: string
    //   - container: string
    //   - destino: string
    //   - data_posicionamento: string
    //   - data_faturamento_vli: string
    //   - horario_posicionamento: string
    //   - horario_faturamento: string
    //   - numero_vagao: string
    //   - hora_chegada: string
    //   - hora_entrada: string
    //   - hora_saida: string
    //   - data_emissao_nf: string
    //   - cte_intertex: string
    //   - data_emissao_cte: string
    //   - cte_transportador: string
    //   - import_batch: string
    //   - branchId: string (required)
    //   - created_at: string
    //   - uid: string (required)
    //
    // Collection: containers
    // Document ID: auto-generated
    // Fields:
    //   - numero: string (required)
    //   - status: string (required) - ["Disponível", "Em Manutenção", "Em Uso"]
    //   - observacao: string
    //   - branchId: string (required)
    //   - updated_at: timestamp
    //   - updated_by_email: string
    //   - uid: string (required)
    //
    // Collection: branches
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - location: string
    //   - code: string (required)
    //   - created_at: timestamp
    //   - uid: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "massote1984@gmail.com" ||
        (request.auth.token.email != null && request.auth.token.email.matches("(?i)^massote1984@gmail\\.com$")) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/app2_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/app2_users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidEntry(data) {
      return data.keys().hasAll(['status', 'uid', 'branchId']) &&
             data.status is string &&
             data.uid is string &&
             data.branchId is string;
    }

    function isValidContainer(data) {
      return data.keys().hasAll(['numero', 'status', 'uid', 'branchId']) &&
             data.numero is string && data.numero.size() > 0 &&
             data.status in ["Disponível", "Em Manutenção", "Em Uso"] &&
             data.uid is string &&
             data.branchId is string;
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['name', 'code', 'uid']) &&
             data.name is string && data.name.size() > 0 &&
             data.code is string && data.code.size() > 0 &&
             data.uid is string;
    }

    function isValidNamedEntity(data) {
      return data.keys().hasAll(['name', 'uid', 'branchId']) &&
             data.name is string && data.name.size() > 0 &&
             data.uid is string &&
             data.branchId is string;
    }

    // Regra Global Mestre para o Administrador:
    // O Administrador Geral possui liberação absoluta para todas as execuções (leitura, criação, edição e exclusão)
    // em qualquer documento e coleção de todo o banco de dados.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Regras para usuários
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
    match /app2_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Regras para filiais
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /app2_branches/{branchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Regras para fornecedores
    match /suppliers/{supplierId} {
      allow read, write: if isAuthenticated();
    }
    match /app2_suppliers/{supplierId} {
      allow read, write: if isAuthenticated();
    }

    // Regras para transportadoras
    match /transporters/{transporterId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /app2_transporters/{transporterId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Regras para clientes
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }
    match /app2_customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    // Regras para produtos
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }
    match /app2_products/{productId} {
      allow read, write: if isAuthenticated();
    }

    // Regras para destinos
    match /destinations/{destinationId} {
      allow read, write: if isAuthenticated();
    }
    match /app2_destinations/{destinationId} {
      allow read, write: if isAuthenticated();
    }

    // Regras para entradas de estoque
    match /entries/{entryId} {
      allow read, write: if isAuthenticated();
    }
    match /app2_entries/{entryId} {
      allow read, write: if isAuthenticated();
    }

    // Regras para containers
    match /containers/{containerId} {
      allow read, write: if isAuthenticated();
    }
    match /app2_containers/{containerId} {
      allow read, write: if isAuthenticated();
    }

    // Regras para janelas horárias de agendamento
    match /slot_configs/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /app2_slot_configs/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Regras para agendamentos de carga e descarga
    match /appointments/{appointmentId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }
    match /app2_appointments/{appointmentId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Regras para configurações globais da aplicação (ex: URL pública do portal)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /app2_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
