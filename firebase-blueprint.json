{
  "entities": {
    "Entry": {
      "title": "Entry",
      "description": "A stock entry record",
      "type": "object",
      "properties": {
        "mes": { "type": "string" },
        "chave_acesso": { "type": "string" },
        "nf_numero": { "type": "string" },
        "tonelada": { "type": "number" },
        "valor": { "type": "number" },
        "descricao_produto": { "type": "string" },
        "data_nf": { "type": "string" },
        "data_descarga": { "type": "string" },
        "status": { "type": "string" },
        "fornecedor": { "type": "string" },
        "placa_veiculo": { "type": "string" },
        "container": { "type": "string" },
        "destino": { "type": "string" },
        "data_posicionamento": { "type": "string" },
        "data_faturamento_vli": { "type": "string" },
        "horario_posicionamento": { "type": "string" },
        "horario_faturamento": { "type": "string" },
        "numero_vagao": { "type": "string" },
        "hora_chegada": { "type": "string" },
        "hora_entrada": { "type": "string" },
        "hora_saida": { "type": "string" },
        "data_emissao_nf": { "type": "string" },
        "cte_intertex": { "type": "string" },
        "data_emissao_cte": { "type": "string" },
        "cte_transportador": { "type": "string" },
        "import_batch": { "type": "string" },
        "branchId": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["status", "branchId"]
    },
    "Container": {
      "title": "Container",
      "description": "A physical container record",
      "type": "object",
      "properties": {
        "numero": { "type": "string" },
        "status": { "type": "string", "enum": ["Disponível", "Em Manutenção", "Em Uso"] },
        "observacao": { "type": "string" },
        "branchId": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" },
        "updated_by_email": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["numero", "status", "branchId"]
    },
    "Branch": {
      "title": "Branch",
      "description": "A company branch or location",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "code": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["name", "code"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A supplier company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "contact": { "type": "string" },
        "branchId": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["name", "branchId"]
    },
    "Transporter": {
      "title": "Transporter",
      "description": "A transporter company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "contact": { "type": "string" },
        "branchId": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["name", "branchId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "A customer company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "contact": { "type": "string" },
        "branchId": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["name", "branchId"]
    },
    "Product": {
      "title": "Product",
      "description": "A product type",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "branchId": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["name", "branchId"]
    },
    "Destination": {
      "title": "Destination",
      "description": "A shipment destination",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "branchId": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["name", "branchId"]
    },
    "SlotConfig": {
      "title": "SlotConfig",
      "description": "Hourly time slot configuration with vehicle or volume limits",
      "type": "object",
      "properties": {
        "branchId": { "type": "string" },
        "hora_inicio": { "type": "string" },
        "hora_fim": { "type": "string" },
        "tipo_limite": { "type": "string", "enum": ["veiculos", "volume"] },
        "limite_veiculos": { "type": "number" },
        "limite_volume_toneladas": { "type": "number" },
        "tipo_operacao_permitida": { "type": "string", "enum": ["todos", "carga", "descarga"] },
        "ativo": { "type": "boolean" },
        "dias_semana": { "type": "array", "items": { "type": "number" } },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["branchId", "hora_inicio", "hora_fim", "tipo_limite"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Carrier vehicle loading or unloading schedule appointment",
      "type": "object",
      "properties": {
        "protocolo": { "type": "string" },
        "branchId": { "type": "string" },
        "data_agendamento": { "type": "string" },
        "hora_inicio": { "type": "string" },
        "hora_fim": { "type": "string" },
        "tipo_operacao": { "type": "string", "enum": ["carga", "descarga"] },
        "transportadora": { "type": "string" },
        "cnpj_transportadora": { "type": "string" },
        "placa_veiculo": { "type": "string" },
        "placa_carreta": { "type": "string" },
        "tipo_veiculo": { "type": "string" },
        "motorista_nome": { "type": "string" },
        "motorista_cpf": { "type": "string" },
        "motorista_telefone": { "type": "string" },
        "descricao_produto": { "type": "string" },
        "peso_estimado_toneladas": { "type": "number" },
        "nf_numero": { "type": "string" },
        "pedido_lote": { "type": "string" },
        "status": { "type": "string", "enum": ["agendado", "em_patio", "em_operacao", "concluido", "cancelado"] },
        "origem": { "type": "string", "enum": ["portal_transportador", "interno"] },
        "hora_chegada_real": { "type": "string" },
        "hora_inicio_operacao": { "type": "string" },
        "hora_conclusao_operacao": { "type": "string" },
        "observacoes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["protocolo", "branchId", "data_agendamento", "hora_inicio", "hora_fim", "tipo_operacao", "placa_veiculo", "status"]
    }
  },
  "firestore": {
    "entries": {
      "schema": "Entry",
      "description": "Collection of stock entries"
    },
    "containers": {
      "schema": "Container",
      "description": "Collection of physical containers"
    },
    "branches": {
      "schema": "Branch",
      "description": "Collection of company branches"
    },
    "suppliers": {
      "schema": "Supplier",
      "description": "Collection of suppliers"
    },
    "transporters": {
      "schema": "Transporter",
      "description": "Collection of transporters"
    },
    "customers": {
      "schema": "Customer",
      "description": "Collection of customers"
    },
    "products": {
      "schema": "Product",
      "description": "Collection of products"
    },
    "destinations": {
      "schema": "Destination",
      "description": "Collection of destinations"
    },
    "slot_configs": {
      "schema": "SlotConfig",
      "description": "Configured hourly windows and capacities"
    },
    "appointments": {
      "schema": "Appointment",
      "description": "Collection of scheduled carrier appointments"
    },
    "app2_entries": {
      "schema": "Entry",
      "description": "Isolated collection of stock entries for independent applet"
    },
    "app2_containers": {
      "schema": "Container",
      "description": "Isolated collection of containers for independent applet"
    },
    "app2_branches": {
      "schema": "Branch",
      "description": "Isolated collection of company branches for independent applet"
    },
    "app2_suppliers": {
      "schema": "Supplier",
      "description": "Isolated collection of suppliers for independent applet"
    },
    "app2_transporters": {
      "schema": "Transporter",
      "description": "Isolated collection of transporters for independent applet"
    },
    "app2_customers": {
      "schema": "Customer",
      "description": "Isolated collection of customers for independent applet"
    },
    "app2_products": {
      "schema": "Product",
      "description": "Isolated collection of products for independent applet"
    },
    "app2_destinations": {
      "schema": "Destination",
      "description": "Isolated collection of destinations for independent applet"
    },
    "app2_slot_configs": {
      "schema": "SlotConfig",
      "description": "Isolated collection of configured hourly windows for independent applet"
    },
    "app2_appointments": {
      "schema": "Appointment",
      "description": "Isolated collection of scheduled carrier appointments for independent applet"
    }
  }
}
